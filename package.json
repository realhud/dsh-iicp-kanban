{
  "name": "dsh-iicp-kanban",
  "version": "0.3.0",
  "description": "DSH 团队任务看板：看板 + 项目 + 团队成员与任务指派 + AI AGENT 执行语义。 / Team kanban for DSH: board, projects, members, assignment and AI-agent task semantics.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "server/",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kanban",
    "team",
    "task-tracking",
    "project-management"
  ],
  "author": "realhud",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "check": "npm test"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
